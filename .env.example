# Supabase — safe to expose (publishable key + project URL are public by design)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Service-role secret — SERVER ONLY. Never prefix with NEXT_PUBLIC.
# Used by the admin panel to create/delete login accounts.
# Get it from Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
